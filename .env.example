# Public Supabase keys (safe for the browser). Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional fallback if you still use the legacy anon JWT:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Existing screenshot AI (server-only)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
